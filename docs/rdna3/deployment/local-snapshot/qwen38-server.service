[Unit]
Description=Qwen3.8-27B rotated INT4 - RX 7900 XT with OMP
Documentation=file:///home/svt/tuning27b-next/service/README.md
After=network-online.target
Wants=network-online.target
# Give up after 5 failed starts in 5 min instead of thrashing the GPU on a bad config.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/home/svt/qwen38-server-agent.sh
Restart=always
RestartSec=10
# Model load takes ~20s from the NVMe; don't let a slow start look like a failure.
TimeoutStartSec=180
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=default.target
