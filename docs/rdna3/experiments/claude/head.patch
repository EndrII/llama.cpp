+__device__ __forceinline__ float gdn_wave_sum(float x) {
+    x += gdn_dpp<0xB1>(x); x += gdn_dpp<0x4E>(x); x += gdn_dpp<0x141>(x); x += gdn_dpp<0x140>(x);
+    return x + gdn_swap_rows(x);
